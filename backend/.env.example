# 复制本文件为 .env 后按需修改（.env 不入库）。

# 运行环境：development / test / production。
# production 禁止 SQLite，必须使用 postgres；默认 development。
YCSP_ENV=development

# 数据管理层监听地址
YCSP_BACKEND_HOST=127.0.0.1
YCSP_BACKEND_PORT=8000

# 数据处理层地址
YCSP_COMPUTE_BASE_URL=http://127.0.0.1:8001

# 数据库引擎：sqlite / postgres / mysql。
# SQLite 只用于本地开发和测试；生产请用 postgres。
YCSP_DB_DRIVER=sqlite

# sqlite 填数据库文件路径；postgres / mysql 填各自连接串（例如
# postgres: host=127.0.0.1 port=5432 user=ycsp password=*** dbname=ycsp sslmode=disable）
YCSP_DB_DSN=ycsp.db

# 连接池：0 表示按驱动默认。SQLite 会固定为单连接；Postgres / MySQL 默认 20 个打开、10 个空闲、30 分钟上限。
YCSP_DB_MAX_OPEN_CONNS=0
YCSP_DB_MAX_IDLE_CONNS=0
YCSP_DB_CONN_MAX_LIFETIME_SECONDS=0

# 启动时自动建表：development / test 默认 true，production 默认 false。
# 需要显式覆盖时取消下面一行的注释：
# YCSP_DB_AUTO_MIGRATE=true
# 生产部署请先执行一次 `go run . -migrate-only`，再启动服务。

# 任务 worker 数：0 表示按驱动自动（sqlite 1，postgres / mysql 4）。
# 可显式设为 1~16；SQLite 写入仍会串行，调大主要提升等待计算时的并发。
YCSP_TASK_WORKERS=0

# 会话：默认存 Redis；本地没有 Redis 时可改成 memory（仅单机开发，重启即掉登录）
YCSP_SESSION_DRIVER=redis
YCSP_REDIS_URL=redis://127.0.0.1:6379/0

# 会话有效期（秒），默认 7 天
YCSP_SESSION_LIFETIME_SECONDS=604800

# 只在 HTTPS 部署时设为 true
YCSP_COOKIE_SECURE=false

# 登录失败限流：同一昵称 / 同一地址在窗口内允许的失败次数，以及窗口（秒）
YCSP_LOGIN_MAX_ATTEMPTS=5
YCSP_LOGIN_IP_MAX_ATTEMPTS=20
YCSP_LOGIN_BLOCK_SECONDS=900

# 反向代理：只有直连地址属于这里列出的 IP / CIDR 时才读 X-Forwarded-For（逗号分隔）。
# nginx 与后端同机时填 127.0.0.1/32；容器部署填 nginx 所在网段；不要填 0.0.0.0/0。
YCSP_TRUSTED_PROXIES=
