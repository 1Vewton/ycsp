# 复制本文件为 .env 后按需修改（.env 不入库）。

# 数据管理层监听地址
YCSP_BACKEND_HOST=127.0.0.1
YCSP_BACKEND_PORT=8000

# 数据处理层地址
YCSP_COMPUTE_BASE_URL=http://127.0.0.1:8001

# 数据库引擎：sqlite / postgres / mysql
YCSP_DB_DRIVER=sqlite

# sqlite 填数据库文件路径；postgres / mysql 填各自连接串（例如
# postgres: host=127.0.0.1 port=5432 user=ycsp password=*** dbname=ycsp sslmode=disable）
YCSP_DB_DSN=ycsp.db

# 会话：默认存 Redis；本地没有 Redis 时可改成 memory（仅单机开发，重启即掉登录）
YCSP_SESSION_DRIVER=redis
YCSP_REDIS_URL=redis://127.0.0.1:6379/0

# 会话有效期（秒），默认 7 天
YCSP_SESSION_LIFETIME_SECONDS=604800

# 只在 HTTPS 部署时设为 true
YCSP_COOKIE_SECURE=false

# 登录失败限流：同一昵称 / 同一地址在窗口内允许的失败次数，以及窗口（秒）
YCSP_LOGIN_MAX_ATTEMPTS=5
YCSP_LOGIN_IP_MAX_ATTEMPTS=20
YCSP_LOGIN_BLOCK_SECONDS=900
